kubeTargetVersionOverride: "{{ K8S_VER }}"

##
global:
  imageRegistry: "registry.talkschool.cn:5000"

defaultRules:
  create: true

## Configuration for alertmanager
alertmanager:
  enabled: true
  podDisruptionBudget:
    enabled: true
    minAvailable: 2
  alertmanagerSpec:
    image:
      registry: registry.talkschool.cn:5000
      repository: brinnatt/alertmanager
      tag: v0.33.1
    replicas: 3
    resources:
      requests:
        cpu: 100m
        memory: 256Mi
      limits:
        cpu: 500m
        memory: 512Mi
    podAntiAffinity: hard
    podAntiAffinityTopologyKey: kubernetes.io/hostname
{% if prom_storage_class != "" %}
    storage:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ prom_storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 10Gi
{% endif %}
  service:
    nodePort: 30902
    type: NodePort 

## Using default values from https://github.com/grafana/helm-charts/blob/main/charts/grafana/values.yaml
grafana:
  enabled: true
  adminUser: admin
  admin:
    existingSecret: grafana-admin
    userKey: admin-user
    passwordKey: admin-password
  image:
    registry: registry.talkschool.cn:5000
    repository: brinnatt/grafana
    tag: "13.1.1"
  initChownData:
    enabled: true
    image:
      registry: registry.talkschool.cn:5000
      repository: brinnatt/busybox
      tag: "1.37"
  persistence:
    enabled: true
    type: sts
{% if prom_storage_class != "" %}
    storageClassName: {{ prom_storage_class }}
{% endif %}
    accessModes:
      - ReadWriteOnce
    size: 20Gi
  resources:
    requests:
      cpu: 200m
      memory: 512Mi
    limits:
      cpu: "1"
      memory: 1Gi
  service:
    nodePort: 30903
    type: NodePort
  sidecar:
    image:
      registry: registry.talkschool.cn:5000
      repository: brinnatt/k8s-sidecar
      tag: "1.30.5"
    skipTlsVerify: true

## Flag to disable all the kubernetes component scrapers
kubernetesServiceMonitors:
  enabled: true

## Component scraping the kube api server
kubeApiServer:
  enabled: true

## Component scraping the kubelet and kubelet-hosted cAdvisor
kubelet:
  enabled: true

## Component scraping the kube controller manager
kubeControllerManager:
  enabled: true
  endpoints:
{% for h in groups['kube_master'] %}
  - {{ h }}
{% endfor %}
  serviceMonitor:
    https: true
    caFile: /etc/prometheus/secrets/etcd-client-cert/etcd-ca

## Component scraping coreDns. Use either this or kubeDns
coreDns:
  enabled: true

## Component scraping etcd
kubeEtcd:
  enabled: true
  endpoints:
{% for h in groups['etcd'] %}
  - {{ h }}
{% endfor %}
  service:
    port: 2379
    targetPort: 2379
  serviceMonitor:
    scheme: https
    caFile: /etc/prometheus/secrets/etcd-client-cert/etcd-ca
    certFile: /etc/prometheus/secrets/etcd-client-cert/etcd-client
    keyFile: /etc/prometheus/secrets/etcd-client-cert/etcd-client-key

## Component scraping kube scheduler
kubeScheduler:
  enabled: true
  endpoints:
{% for h in groups['kube_master'] %}
  - {{ h }}
{% endfor %}
  serviceMonitor:
    https: true
    caFile: /etc/prometheus/secrets/etcd-client-cert/etcd-ca

## Component scraping kube proxy
kubeProxy:
  enabled: true
  endpoints:
{% for h in groups['kube_master'] %}
  - {{ h }}
{% endfor %}
{% for h in groups['kube_node'] %}
{% if h not in groups['kube_master'] %}
  - {{ h }}
{% endif %}
{% endfor %}

## Component scraping kube state metrics
kubeStateMetrics:
  enabled: true

## Configuration for kube-state-metrics subchart
kube-state-metrics:
  image:
    registry: registry.talkschool.cn:5000
    repository: brinnatt/kube-state-metrics
    tag: v2.18.0

## Deploy node exporter as a daemonset to all nodes
nodeExporter:
  enabled: true
  operatingSystems:
    linux:
      enabled: true
    aix:
      enabled: false
    darwin:
      enabled: false

## Configuration for prometheus-node-exporter subchart
prometheus-node-exporter:
  image:
    registry: registry.talkschool.cn:5000
    repository: brinnatt/node-exporter
    tag: v1.12.1
    # Keep the rendered image equal to the pinned v1.12.1 artifact.
    distroless: false

## Manages Prometheus and Alertmanager components
prometheusOperator:
  enabled: true
  admissionWebhooks:
    enabled: true
    patch:
      enabled: true
      image:
        registry: registry.talkschool.cn:5000
{% if (prom_chart_ver | default("88.0.0")) == "75.7.0" %}
        repository: brinnatt/kube-webhook-certgen
        tag: v1.6.0
{% else %}
        repository: brinnatt/prometheus-webhook-certgen
        tag: 1.8.5
{% endif %}
    deployment:
      enabled: true
      replicas: 2
      podDisruptionBudget:
        enabled: true
        minAvailable: 1
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app: kube-prometheus-stack-operator-webhook
                  release: prometheus
              topologyKey: kubernetes.io/hostname
      image:
        registry: registry.talkschool.cn:5000
        repository: brinnatt/prometheus-admission-webhook
        tag: v0.93.0
  image:
    registry: registry.talkschool.cn:5000
    repository: brinnatt/prometheus-operator
    tag: v0.93.0
  service:
    nodePort: 30899
    nodePortTls: 30900
    type: NodePort
  prometheusConfigReloader:
    image:
      registry: registry.talkschool.cn:5000
      repository: brinnatt/prometheus-config-reloader
      tag: v0.93.0

## Deploy a Prometheus instance
prometheus:
  enabled: true
  podDisruptionBudget:
    enabled: true
    minAvailable: 1
  service:
    nodePort: 30901
    type: NodePort

  prometheusSpec:
    image:
      registry: registry.talkschool.cn:5000
      repository: brinnatt/prometheus
      tag: v3.13.1-distroless
    replicas: 2
    resources:
      requests:
        cpu: "1"
        memory: 4Gi
      limits:
        cpu: "4"
        memory: 8Gi
    retention: 15d
    externalLabels:
      cluster: "{{ CLUSTER_NAME }}"
    podAntiAffinity: hard
    podAntiAffinityTopologyKey: kubernetes.io/hostname
    secrets:
    - etcd-client-cert
{% if prom_storage_class != "" %}
    storageSpec:
      volumeClaimTemplate:
        spec:
          storageClassName: {{ prom_storage_class }}
          accessModes: ["ReadWriteOnce"]
          resources:
            requests:
              storage: 20Gi
{% else %}
    storageSpec: {}
{% endif %}
{% if (prom_thanos_install | default("no") | string | lower) == "yes" and (prom_optional_uninstall | default("no") | string | lower) != "yes" %}
    # Keep the Prometheus Operator replica label explicit.  Thanos Query uses
    # the same key to merge HA replicas without merging distinct clusters.
    replicaExternalLabelName: prometheus_replica
    thanos:
      image: registry.talkschool.cn:5000/brinnatt/thanos:v0.41.0
      version: v0.41.0
{% if (prom_thanos_objectstorage_secret | default("")) != "" %}
      objectStorageConfig:
        existingSecret:
          name: {{ prom_thanos_objectstorage_secret }}
          key: thanos.yaml
{% endif %}
  thanosService:
    enabled: true
    type: ClusterIP
  thanosServiceMonitor:
    enabled: true
{% endif %}
