# https://nacos.io/docs/latest/overview
# https://github.com/nacos-group/nacos-k8s/wiki/使用peerfinder扩容插件
---
apiVersion: v1
kind: Service
metadata:
  name: nacos-headless
  namespace: {{ nacos_namespace }}
  labels:
    app: nacos
spec:
  publishNotReadyAddresses: true 
  ports:
    - port: 8848
      name: server
      targetPort: 8848
    - port: 9848
      name: client-rpc
      targetPort: 9848
    - port: 9849
      name: raft-rpc
      targetPort: 9849
    - port: 7848
      name: old-raft-rpc
      targetPort: 7848
  clusterIP: None
  selector:
    app: nacos
---
# 访问nacos 控制台 http://${nodeIp}:${nodePort}/nacos
apiVersion: v1
kind: Service
metadata:
  name: nacos
  namespace: {{ nacos_namespace }}
  labels:
    app: nacos
spec:
  ports:
    - port: 8848
      name: server
      targetPort: 8848
    - port: 9848
      name: client-rpc
      targetPort: 9848
  selector:
    app: nacos
  type: NodePort
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nacos-cm
  namespace: {{ nacos_namespace }}
data:
  mysql.host: "{{ nacos_mysql_host }}"
  mysql.db.name: "{{ nacos_mysql_db }}"
  mysql.port: "{{ nacos_mysql_port }}"
  mysql.user: "{{ nacos_mysql_user }}"
---
apiVersion: v1
kind: Secret
metadata:
  name: nacos-mysql-client
  namespace: {{ nacos_namespace }}
type: Opaque
stringData:
  mysql.password: {{ nacos_mysql_password | to_json }}
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: nacos
  namespace: {{ nacos_namespace }}
spec:
  podManagementPolicy: Parallel
  serviceName: nacos-headless
  replicas: {{ nacos_replicas | default(3) }}
  selector:
    matchLabels:
      app: nacos
  template:
    metadata:
      labels:
        app: nacos
      annotations:
        pod.alpha.kubernetes.io/initialized: "true"
    spec:
      affinity:
        podAntiAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchExpressions:
                  - key: "app"
                    operator: In
                    values:
                      - nacos
              topologyKey: "kubernetes.io/hostname"
      initContainers:
{% if nacos_mysql_ca_secret | default('') %}
        # Import only the public CA into an ephemeral trust store. The password
        # protects its format, not a private key or an authentication credential.
        - name: mysql-truststore
          image: registry.talkschool.cn:5000/brinnatt/nacos-server:v2.4.3
          command: ["/bin/sh", "-ec"]
          args:
            - >-
              rm -f /mysql-tls/truststore.p12 &&
              keytool -importcert -noprompt -alias mysql-ca
              -file /mysql-ca/ca.crt -keystore /mysql-tls/truststore.p12
              -storetype PKCS12 -storepass changeit
          volumeMounts:
            - name: mysql-ca
              mountPath: /mysql-ca
              readOnly: true
            - name: mysql-truststore
              mountPath: /mysql-tls
{% endif %}
        - name: peer-finder-plugin-install
          image: registry.talkschool.cn:5000/brinnatt/nacos-peer-finder-plugin:1.1
          volumeMounts:
            - mountPath: /home/nacos/plugins/peer-finder
              name: data
              subPath: peer-finder
      containers:
        - name: nacos
          image: registry.talkschool.cn:5000/brinnatt/nacos-server:v2.4.3
          resources:
            requests:
              memory: "{{ nacos_mem_request | default('512Mi') }}"
              cpu: "{{ nacos_cpu_request | default('200m') }}"
          ports:
            - containerPort: 8848
              name: client-port
            - containerPort: 9848
              name: client-rpc
            - containerPort: 9849
              name: raft-rpc
            - containerPort: 7848
              name: old-raft-rpc
          startupProbe:
            httpGet:
              path: /nacos/v1/console/health/readiness
              port: client-port
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 90
          readinessProbe:
            httpGet:
              path: /nacos/v1/console/health/readiness
              port: client-port
            periodSeconds: 10
            timeoutSeconds: 3
            failureThreshold: 3
          env:
            # nacos-docker exposes these variables in docker-startup.sh.
            # Keep its upstream defaults unless an installation explicitly
            # sizes the JVM for a smaller delivery/test node.
            - name: JVM_XMS
              value: "{{ nacos_jvm_xms | default('1g') }}"
            - name: JVM_XMX
              value: "{{ nacos_jvm_xmx | default('1g') }}"
            - name: JVM_XMN
              value: "{{ nacos_jvm_xmn | default('512m') }}"
            - name: NACOS_REPLICAS
              value: "{{ nacos_replicas | default(3) }}"
            - name: SERVICE_NAME
              value: "nacos-headless"
            - name: DOMAIN_NAME
              value: "{{ CLUSTER_DNS_DOMAIN }}"
            - name: POD_NAMESPACE
              valueFrom:
                fieldRef:
                  apiVersion: v1
                  fieldPath: metadata.namespace
            - name: POD_IP
              valueFrom:
                fieldRef:
                  apiVersion: v1
                  fieldPath: status.podIP
            - name: MYSQL_SERVICE_HOST
              valueFrom:
                configMapKeyRef:
                  name: nacos-cm
                  key: mysql.host
            - name: MYSQL_SERVICE_DB_NAME
              valueFrom:
                configMapKeyRef:
                  name: nacos-cm
                  key: mysql.db.name
            - name: MYSQL_SERVICE_PORT
              valueFrom:
                configMapKeyRef:
                  name: nacos-cm
                  key: mysql.port
            - name: MYSQL_SERVICE_USER
              valueFrom:
                configMapKeyRef:
                  name: nacos-cm
                  key: mysql.user
            - name: MYSQL_SERVICE_PASSWORD
              valueFrom:
                secretKeyRef:
                  name: nacos-mysql-client
                  key: mysql.password
            - name: MYSQL_SERVICE_DB_PARAM
              value: "{{ nacos_mysql_db_param | default('characterEncoding=utf8&connectTimeout=1000&socketTimeout=3000&autoReconnect=true&useUnicode=true&sslMode=VERIFY_IDENTITY&serverTimezone=UTC') }}{% if nacos_mysql_ca_secret | default('') %}&trustCertificateKeyStoreUrl=file:/home/nacos/mysql-tls/truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=changeit{% endif %}"
            - name: SPRING_DATASOURCE_PLATFORM
              value: "mysql"
            - name: NACOS_SERVER_PORT
              value: "8848"
            - name: NACOS_APPLICATION_PORT
              value: "8848"
            - name: PREFER_HOST_MODE
              value: "hostname"
            - name: NACOS_AUTH_ENABLE
              value: "true"
            - name: NACOS_AUTH_SYSTEM_TYPE
              value: "nacos"
            - name: NACOS_AUTH_CACHE_ENABLE
              value: "true"
            - name: NACOS_AUTH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: {{ nacos_auth_secret }}
                  key: token
            - name: NACOS_AUTH_IDENTITY_KEY
              valueFrom:
                secretKeyRef:
                  name: {{ nacos_auth_secret }}
                  key: identity-key
            - name: NACOS_AUTH_IDENTITY_VALUE
              valueFrom:
                secretKeyRef:
                  name: {{ nacos_auth_secret }}
                  key: identity-value
          volumeMounts:
{% if nacos_mysql_ca_secret | default('') %}
            - name: mysql-truststore
              mountPath: /home/nacos/mysql-tls
              readOnly: true
{% endif %}
            - name: data
              mountPath: /home/nacos/plugins/peer-finder
              subPath: peer-finder
            - name: data
              mountPath: /home/nacos/data
              subPath: data
            - name: data
              mountPath: /home/nacos/logs
              subPath: logs
{% if nacos_mysql_ca_secret | default('') %}
      volumes:
        - name: mysql-ca
          secret:
            secretName: {{ nacos_mysql_ca_secret }}
            items:
              - key: ca.crt
                path: ca.crt
        - name: mysql-truststore
          emptyDir: {}
{% endif %}
  volumeClaimTemplates:
    - apiVersion: v1
      kind: PersistentVolumeClaim
      metadata:
        name: data
      spec:
        accessModes: [ "ReadWriteOnce" ]
        resources:
          requests:
            storage: {{ nacos_storage_size | default('5Gi') }}
        storageClassName: {{ nacos_storage_class }}
        volumeMode: Filesystem
