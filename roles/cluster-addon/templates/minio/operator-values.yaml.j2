operator:
  # https://github.com/minio/operator/blob/master/docs/env-variables.md
  env:
    - name: OPERATOR_STS_ENABLED
      value: "on"
  image:
    repository: registry.talkschool.cn:5000/brinnatt/minio-operator
  sidecarImage:
    repository: registry.talkschool.cn:5000/brinnatt/minio-operator-sidecar
    tag: v7.0.1
  replicaCount: 1
  resources:
    requests:
      cpu: 200m
      memory: 256Mi
      ephemeral-storage: 500Mi
    limits:
      cpu: 500m
      memory: 512Mi
      ephemeral-storage: 500Mi
