kind: KubeletConfiguration
apiVersion: kubelet.config.k8s.io/v1beta1
address: 0.0.0.0
authentication:
  anonymous:
    enabled: false
  webhook:
    cacheTTL: 2m0s
    enabled: true
  x509:
    clientCAFile: {{ ca_dir }}/ca.pem
authorization:
  mode: Webhook
  webhook:
    cacheAuthorizedTTL: 5m0s
    cacheUnauthorizedTTL: 30s
cgroupDriver: {{ CGROUP_DRIVER }} 
cgroupsPerQOS: true
clusterDNS:
{% if ENABLE_LOCAL_DNS_CACHE %}
- {{ LOCAL_DNS_CACHE }}
{% else %}
- {{ CLUSTER_DNS_SVC_IP }}
{% endif %}
clusterDomain: {{ CLUSTER_DNS_DOMAIN }}
configMapAndSecretChangeDetectionStrategy: Watch
containerLogMaxFiles: 3 
containerLogMaxSize: 10Mi
# Node Allocatable enforcement keys.
# Docs: https://kubernetes.io/docs/tasks/administer-cluster/reserve-compute-resources/#enforcing-node-allocatable
# Source: pkg/kubelet/cm/node_container_manager_linux.go (enforceNodeAllocatableCgroups)
enforceNodeAllocatable:
- pods
{% if KUBE_RESERVED_ENABLED == "yes" %}
- kube-reserved
{% endif %}
{#
  Official warning (same reserve-compute-resources page): enforcing system-reserved
  hard-limits system.slice. Control-plane (kube-apiserver/etcd) and OS daemons share
  that slice — tender baseline SYS_RESERVED_MEMORY=1000Mi is enough for Allocatable
  accounting but too small as a hard MemoryMax under addon/CRD storms.
  Therefore: systemReserved* always applied when SYS_RESERVED_ENABLED=yes (capacity
  subtraction), but enforceNodeAllocatable += system-reserved only when
  SYS_RESERVED_ENFORCE=yes (opt-in).
#}
{% if SYS_RESERVED_ENABLED == "yes" and (SYS_RESERVED_ENFORCE | default('no')) == "yes" %}
- system-reserved
{% endif %}
eventBurst: 10
eventRecordQPS: 5
evictionHard:
  imagefs.available: 15%
  memory.available: 300Mi
  nodefs.available: 10%
  nodefs.inodesFree: 5%
evictionPressureTransitionPeriod: 5m0s
failSwapOn: true
fileCheckFrequency: 40s
hairpinMode: hairpin-veth 
healthzBindAddress: 0.0.0.0
healthzPort: 10248
httpCheckFrequency: 40s
imageGCHighThresholdPercent: 85
imageGCLowThresholdPercent: 80
imageMinimumGCAge: 2m0s
{% if KUBE_RESERVED_ENABLED == "yes" %}
{#
  kubeReservedCgroup naming (critical for production):
  Docs: https://kubernetes.io/docs/tasks/administer-cluster/reserve-compute-resources/#kube-reserved
    "With systemd cgroup driver, you should follow a specific pattern for the name
     of the cgroup you define: the name should be the value you set for
     kubeReservedCgroup, with .slice appended."
  Source: pkg/kubelet/cm/cgroup_manager_linux.go — ToSystemd() appends ".slice"
  Bug if set to /podruntime.slice under systemd → podruntime.slice.slice:
    https://github.com/kubernetes/kubernetes/issues/78629
  Therefore:
    - systemd driver → /podruntime  (host: podruntime.slice)
    - cgroupfs driver → /podruntime.slice (literal cgroupfs path)
#}
{% if CGROUP_DRIVER == "systemd" %}
kubeReservedCgroup: /podruntime
{% else %}
kubeReservedCgroup: /podruntime.slice
{% endif %}
kubeReserved:
  cpu: {{ KUBE_RESERVED_CPU | default('500m') }}
  memory: {{ KUBE_RESERVED_MEMORY | default('1000Mi') }}
  pid: "{{ KUBE_RESERVED_PID | default('1000') }}"
{% endif %}
kubeAPIBurst: 100
kubeAPIQPS: 50
makeIPTablesUtilChains: true
maxOpenFiles: 1000000
maxParallelImagePulls: 5
maxPods: {{ MAX_PODS }}
nodeLeaseDurationSeconds: 40
nodeStatusReportFrequency: 1m0s
nodeStatusUpdateFrequency: 10s
oomScoreAdj: -999
podPidsLimit: {{ POD_MAX_PIDS }}
port: 10250
# disable readOnlyPort 
readOnlyPort: 0
resolvConf: /etc/resolv.conf
runtimeRequestTimeout: 2m0s
serializeImagePulls: false
streamingConnectionIdleTimeout: 4h0m0s
syncFrequency: 1m0s
{% if SYS_RESERVED_ENABLED == "yes" %}
{#
  systemReservedCgroup: same systemd naming rule as kubeReservedCgroup.
  Docs: https://kubernetes.io/docs/tasks/administer-cluster/reserve-compute-resources/#system-reserved
  Recommended parent for OS daemons: system.slice → configure as /system under systemd.
  WARNING (same official page): enforcing system-reserved can starve OS daemons if values
  are too low; contract requires enablement — values are the tender baseline (raise on large nodes).
#}
{% if CGROUP_DRIVER == "systemd" %}
systemReservedCgroup: /system
{% else %}
systemReservedCgroup: /system.slice
{% endif %}
systemReserved:
  cpu: {{ SYS_RESERVED_CPU | default('500m') }}
  memory: {{ SYS_RESERVED_MEMORY | default('1000Mi') }}
  pid: "{{ SYS_RESERVED_PID | default('5000') }}"
{% endif %}
tlsCertFile: {{ ca_dir }}/kubelet.pem
tlsPrivateKeyFile: {{ ca_dir }}/kubelet-key.pem
