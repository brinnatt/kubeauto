{
  "deployment_note": "键名与 kafkacli 命令行长选项一致（下划线）；须与 kafkacli -h、KafkaCli.py 模块头、分步示例一致维护。KRaft（Kafka 3.3+）。同一集群内 node_id 须在全部 controller 与 broker 间全局唯一。--deploy controller 须必选 controller_scope：single（单台）或 cluster（多节点仲裁）。cluster：首台空盘仅 generate_cluster_id；第 2 台起须 cluster_id（与首台一致）与 join_quorum。standalone/controller 的 cluster.id 须三选一：cluster_id、generate_cluster_id、use_disk_cluster_id。controller 须 metadata_log_dir 与 log_dirs。--batch 时 nodes[] 可含 ssh_user、ssh_port、ssh_key 等。",
  "kafka_home": "/opt/kafka",
  "user": "kafka",
  "group": "kafka",
  "java_home": "/usr/lib/jvm/java-21-openjdk",
  "log_dirs": "/var/kafka/logs",
  "metadata_log_dir": "/var/kafka/metadata-log",
  "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093",
  "controller_port": 9093,
  "listeners": "PLAINTEXT://0.0.0.0:9092",
  "bootstrap_server": "broker1:9092",
  "extra_properties": {
    "num.partitions": "3",
    "default.replication.factor": "2"
  },
  "nodes": [
    {
      "target_host": "controller1",
      "deploy": "controller",
      "controller_scope": "cluster",
      "node_id": 1,
      "advertised_host": "controller1",
      "metadata_log_dir": "/var/kafka/metadata-log",
      "log_dirs": "/var/kafka/controller-log",
      "generate_cluster_id": true,
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    },
    {
      "target_host": "controller2",
      "deploy": "controller",
      "controller_scope": "cluster",
      "node_id": 2,
      "advertised_host": "controller2",
      "cluster_id": "<从第一台 controller 部署输出或 meta 中获取，与集群一致>",
      "join_quorum": true,
      "metadata_log_dir": "/var/kafka/metadata-log",
      "log_dirs": "/var/kafka/controller-log",
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    },
    {
      "target_host": "controller3",
      "deploy": "controller",
      "controller_scope": "cluster",
      "node_id": 3,
      "advertised_host": "controller3",
      "cluster_id": "<同上>",
      "join_quorum": true,
      "metadata_log_dir": "/var/kafka/metadata-log",
      "log_dirs": "/var/kafka/controller-log",
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    },
    {
      "target_host": "broker1",
      "deploy": "broker",
      "node_id": 4,
      "advertised_host": "broker1",
      "cluster_id": "<同上>",
      "log_dirs": "/var/kafka/logs",
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    }
  ]
}
