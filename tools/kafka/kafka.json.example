{
  "deployment_note": "键名与 kafkacli 命令行长选项一致（下划线）；须与 kafkacli -h、KafkaCli.py 模块头、分步示例一致维护。KRaft（Kafka 3.3+）。同一集群内 node_id 须在全部 controller 与 broker 间全局唯一。standalone/controller 部署须三选一：cluster_id、generate_cluster_id、use_disk_cluster_id。controller 须同时提供 metadata_log_dir 与 log_dirs（无隐式默认路径）。多节点时每个 nodes[] 项须含本机 advertised_host（与 Apache Kafka advertised.listeners 一致），与 controller_quorum_bootstrap_servers 中各 Controller 端点对应。--batch 时 nodes[] 可含 ssh_user、ssh_port、ssh_key 等覆盖根级 SSH 参数（仅该节点连接）。",
  "kafka_home": "/opt/kafka",
  "user": "kafka",
  "group": "kafka",
  "java_home": "/usr/lib/jvm/java-21-openjdk",
  "log_dirs": "/var/kafka/logs",
  "metadata_log_dir": "/var/kafka/metadata-log",
  "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093",
  "controller_port": 9093,
  "listeners": "PLAINTEXT://0.0.0.0:9092",
  "bootstrap_server": "broker1:9092",
  "extra_properties": {
    "num.partitions": "3",
    "default.replication.factor": "2"
  },
  "nodes": [
    {
      "target_host": "controller1",
      "deploy": "controller",
      "node_id": 1,
      "advertised_host": "controller1",
      "metadata_log_dir": "/var/kafka/metadata-log",
      "log_dirs": "/var/kafka/controller-log",
      "generate_cluster_id": true,
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    },
    {
      "target_host": "controller2",
      "deploy": "controller",
      "node_id": 2,
      "advertised_host": "controller2",
      "cluster_id": "<从第一台 controller 部署输出或 meta 中获取，与集群一致>",
      "metadata_log_dir": "/var/kafka/metadata-log",
      "log_dirs": "/var/kafka/controller-log",
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    },
    {
      "target_host": "controller3",
      "deploy": "controller",
      "node_id": 3,
      "advertised_host": "controller3",
      "cluster_id": "<同上>",
      "metadata_log_dir": "/var/kafka/metadata-log",
      "log_dirs": "/var/kafka/controller-log",
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    },
    {
      "target_host": "broker1",
      "deploy": "broker",
      "node_id": 4,
      "advertised_host": "broker1",
      "cluster_id": "<同上>",
      "log_dirs": "/var/kafka/logs",
      "controller_quorum_bootstrap_servers": "controller1:9093,controller2:9093,controller3:9093"
    }
  ]
}
