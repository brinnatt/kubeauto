BE_COMPOSE_PROJECT=starrocks-be
BE_HOSTNAME=starrocks-be
BE_IMAGE=hub.talkedu.cn/kubeauto/starrocks-allin1:3.5.7

# Linux host path. Point this to a mounted local data disk BEFORE first startup.
BE_DATA_ROOT=/data/starrocks-be

# Use the host's private IP for access from other machines.
BE_BIND_IP=127.0.0.1
BE_QUERY_PORT=9030
BE_FE_HTTP_PORT=8030
BE_NODE_HTTP_PORT=8040

# Container total; coordinate with FE heap and BE mem_limit in conf/.
BE_MEMORY_LIMIT=16g

# Keep empty for the initial startup of a NEW database.
# After setting the root password in SQL, put the SAME password here.
# Single quotes preserve literal $ and # characters in Compose .env files.
BE_ROOT_PASSWORD=''
