CN_COMPOSE_PROJECT=starrocks-cn
CN_FE_IMAGE=hub.talkedu.cn/kubeauto/starrocks-fe:3.5.7
CN_NODE_IMAGE=hub.talkedu.cn/kubeauto/starrocks-cn:3.5.7
CN_RUSTFS_IMAGE=hub.talkedu.cn/kubeauto/rustfs:1.0.5
CN_AWS_CLI_IMAGE=hub.talkedu.cn/kubeauto/aws-cli:2.27.49

# CN shared-data compose variables. Do not reuse the BE DATA_ROOT.
CN_DATA_ROOT=/data/starrocks-cn
CN_BIND_IP=127.0.0.1
CN_QUERY_PORT=9030
CN_FE_HTTP_PORT=8030
# CN HTTP is fixed to 8040 on both sides for Stream Load redirects.
CN_FE_MEMORY_LIMIT=6g
CN_NODE_MEMORY_LIMIT=10g
CN_RUSTFS_MEMORY_LIMIT=4g

# RustFS must have ownership/access for its runtime UID 10001:10001.
CN_RUSTFS_DATA_ROOT=/data/starrocks-cn/rustfs
CN_RUSTFS_LOG_ROOT=/data/starrocks-cn/logs/rustfs
CN_RUSTFS_BIND_IP=127.0.0.1
CN_RUSTFS_S3_PORT=9000
CN_RUSTFS_CONSOLE_PORT=9001
CN_RUSTFS_BUCKET=starrocks
CN_RUSTFS_REGION=us-east-1
# Fill these before startup; no working default credentials are supplied.
CN_RUSTFS_ACCESS_KEY=
CN_RUSTFS_SECRET_KEY=

# Empty only for a new StarRocks FE. Existing FE data requires its current password.
CN_ROOT_PASSWORD=''
